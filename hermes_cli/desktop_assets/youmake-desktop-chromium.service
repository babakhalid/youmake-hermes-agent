# Rendered by `hermes desktop setup` -- edits are overwritten on the next setup.
[Unit]
Description=Youmake desktop: persistent headful Chromium (CDP on 127.0.0.1:${cdp_port})
PartOf=youmake-desktop.target
BindsTo=youmake-desktop-xvfb.service
After=youmake-desktop-xvfb.service ${chromium_after}

[Service]
Type=simple
User=${user}
Group=${group}
Environment=HOME=${home}
Environment=DISPLAY=${display}
ExecStartPre=${wait_display}
# systemd guarantees a single instance, so a leftover profile lock is always stale.
ExecStartPre=-/bin/rm -f ${stale_locks}
ExecStart=${chrome_cmd}
Restart=always
RestartSec=3
# CX23 has 4 GB shared with Hermes: throttle, then kill+restart Chromium
# before the kernel OOM killer picks the agent.
MemoryHigh=${memory_high}
MemoryMax=${memory_max}
OOMScoreAdjust=500
